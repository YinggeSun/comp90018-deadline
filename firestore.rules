rules_version = '2';

// Security rules for the online leaderboard (#38, #51), cloud progress and transfer codes
// (#39). Everything not matched below is denied. See docs/firestore-security.md for the
// reasoning behind each check.
service cloud.firestore {
  match /databases/{database}/documents {

    // The six semester levels (SemesterLevel.ALL).
    function isKnownLevel(levelId) {
      return levelId in ['level_1', 'level_2', 'level_3', 'level_4', 'level_5', 'level_6'];
    }

    // The week a win records for each level: its last semester week
    // (SemesterDifficulty.lastWeekForLevel).
    function weekFor(levelId) {
      return {
        'level_1': 2, 'level_2': 4, 'level_3': 6,
        'level_4': 8, 'level_5': 10, 'level_6': 12
      }[levelId];
    }

    // Fastest plausible completion: 250 ms per tile, a sustained four taps a second on every
    // tile of the board (18, 27, 36, 45, 54 and 63 tiles). Real play is far slower; this only
    // rejects forged times.
    function minTimeMillis(levelId) {
      return {
        'level_1': 4500, 'level_2': 6750, 'level_3': 9000,
        'level_4': 11250, 'level_5': 13500, 'level_6': 15750
      }[levelId];
    }

    // No completion is plausible beyond a day.
    function maxTimeMillis() {
      return 86400000;
    }

    // Exactly the fields the app writes, with the right types and values.
    function isValidEntry(levelId, userId) {
      let entry = request.resource.data;
      return entry.keys().hasAll(['uid', 'nickname', 'timeMillis', 'week', 'submittedAt'])
        && entry.keys().hasOnly(['uid', 'nickname', 'timeMillis', 'week', 'submittedAt'])
        && entry.uid == userId
        && entry.nickname is string
        && entry.nickname.size() <= 20
        && entry.nickname.trim().size() > 0
        && entry.timeMillis is int
        && entry.timeMillis >= minTimeMillis(levelId)
        && entry.timeMillis <= maxTimeMillis()
        && entry.week is int
        && entry.week == weekFor(levelId)
        && entry.submittedAt == request.time;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A stored Personal Best for [level]: absent, or a well-formed, plausible time.
    function isValidBest(bests, level) {
      return !(level in bests)
        || (bests[level] is map
          && bests[level].keys().hasAll(['timeMillis', 'achievedAtMillis'])
          && bests[level].keys().hasOnly(['timeMillis', 'achievedAtMillis'])
          && bests[level].timeMillis is int
          && bests[level].timeMillis >= minTimeMillis(level)
          && bests[level].achievedAtMillis is int);
    }

    // The new Personal Best for [level] is no slower than the stored one, if there was one.
    function keepsBest(newBests, oldBests, level) {
      return !(level in oldBests)
        || (level in newBests && newBests[level].timeMillis <= oldBests[level].timeMillis);
    }

    // The progress fields (shared by cloud progress and transfer codes) have valid values.
    function hasValidProgressFields(progress) {
      let bests = progress.personalBests;
      return progress.completedLevelIds is list
        && progress.completedLevelIds.hasOnly(['level_1', 'level_2', 'level_3', 'level_4', 'level_5', 'level_6'])
        && progress.highestUnlockedWeek is int
        && progress.highestUnlockedWeek >= 1
        && progress.highestUnlockedWeek <= 12
        && bests is map
        && bests.keys().hasOnly(['level_1', 'level_2', 'level_3', 'level_4', 'level_5', 'level_6'])
        && isValidBest(bests, 'level_1') && isValidBest(bests, 'level_2') && isValidBest(bests, 'level_3')
        && isValidBest(bests, 'level_4') && isValidBest(bests, 'level_5') && isValidBest(bests, 'level_6')
        && progress.lastModifiedMillis is int;
    }

    // Exactly the fields the app writes for a player's progress, with valid values.
    function isValidProgress() {
      let progress = request.resource.data;
      return progress.keys().hasAll(['completedLevelIds', 'highestUnlockedWeek', 'personalBests', 'lastModifiedMillis', 'updatedAt'])
        && progress.keys().hasOnly(['completedLevelIds', 'highestUnlockedWeek', 'personalBests', 'lastModifiedMillis', 'updatedAt'])
        && hasValidProgressFields(progress)
        && progress.updatedAt == request.time;
    }

    // Transfer codes use 8 characters without look-alikes (TransferCode.ALPHABET).
    function isValidCode(code) {
      return code.matches('^[2-9A-HJ-NP-Z]{8}$');
    }

    // A snapshot of the creator's own progress that expires within a day.
    function isValidTransfer() {
      let transfer = request.resource.data;
      return transfer.keys().hasAll(['ownerId', 'completedLevelIds', 'highestUnlockedWeek', 'personalBests', 'lastModifiedMillis', 'createdAt', 'expiresAt'])
        && transfer.keys().hasOnly(['ownerId', 'completedLevelIds', 'highestUnlockedWeek', 'personalBests', 'lastModifiedMillis', 'createdAt', 'expiresAt'])
        && transfer.ownerId == request.auth.uid
        && hasValidProgressFields(transfer)
        && transfer.createdAt == request.time
        && transfer.expiresAt is timestamp
        && transfer.expiresAt > request.time
        && transfer.expiresAt <= request.time + duration.value(24, 'h');
    }

    // Anyone signed in who knows a code may read it until it expires; codes cannot be listed,
    // changed or deleted. A missing code also reads as refused, so codes cannot be probed.
    match /transfers/{code} {
      allow get: if request.auth != null && request.time < resource.data.expiresAt;
      allow create: if request.auth != null && isValidCode(code) && isValidTransfer();
      allow list, update, delete: if false;
    }

    // An update never loses a completed level, an unlocked week or a faster Personal Best.
    function neverWorse() {
      let next = request.resource.data;
      let stored = resource.data;
      return next.completedLevelIds.hasAll(stored.completedLevelIds)
        && next.highestUnlockedWeek >= stored.highestUnlockedWeek
        && keepsBest(next.personalBests, stored.personalBests, 'level_1')
        && keepsBest(next.personalBests, stored.personalBests, 'level_2')
        && keepsBest(next.personalBests, stored.personalBests, 'level_3')
        && keepsBest(next.personalBests, stored.personalBests, 'level_4')
        && keepsBest(next.personalBests, stored.personalBests, 'level_5')
        && keepsBest(next.personalBests, stored.personalBests, 'level_6');
    }

    match /progress/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProgress();
      allow update: if isOwner(userId) && isValidProgress() && neverWorse();
      allow delete: if false;
    }

    match /leaderboard/{levelId}/entries/{userId} {
      allow read: if request.auth != null && isKnownLevel(levelId);
      allow create: if isOwner(userId) && isKnownLevel(levelId) && isValidEntry(levelId, userId);
      // A player may only replace their own entry with a faster time.
      allow update: if isOwner(userId) && isKnownLevel(levelId) && isValidEntry(levelId, userId)
        && request.resource.data.timeMillis < resource.data.timeMillis;
      allow delete: if false;
    }
  }
}
