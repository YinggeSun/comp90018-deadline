<?xml version="1.0" encoding="utf-8"?>
<!--
  App icon foreground: a clock at 11:55, just before the deadline. The hour hand points to
  twelve and the highlighter-yellow minute hand is five minutes short of it. Everything stays
  inside the 66dp safe zone (21..87) so launcher masks never cut it off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Clock face -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,30a24,24 0,1 1,0 48a24,24 0,1 1,0 -48z"
        android:strokeWidth="5"
        android:strokeColor="#FBF8F1" />
    <!-- Hour marks at 12, 3, 6 and 9 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,36.5v4M71.5,54h-4M54,71.5v-4M36.5,54h4"
        android:strokeLineCap="round"
        android:strokeWidth="3"
        android:strokeColor="#FBF8F1" />
    <!-- Hour hand pointing to twelve -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54v-12"
        android:strokeLineCap="round"
        android:strokeWidth="4.5"
        android:strokeColor="#FBF8F1" />
    <!-- Minute hand at 55 minutes -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54l-8.5,-14.7"
        android:strokeLineCap="round"
        android:strokeWidth="3.5"
        android:strokeColor="#FFB870" />
    <!-- Centre pin -->
    <path
        android:fillColor="#FFB870"
        android:pathData="M54,51a3,3 0,1 1,0 6a3,3 0,1 1,0 -6z" />
</vector>
